{
  "name": "@gobrand/calendar-core",
  "version": "1.1.0",
  "description": "Headless Temporal calendar engine for TypeScript — month, week & day views, overlap layout, multi-day bars, DnD math, and zero-polyfill /native.",
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-brand/calendar.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/go-brand/calendar/issues"
  },
  "homepage": "https://calendar.gobrand.app",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "fast-check": "^4.8.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "temporal",
    "calendar",
    "headless-calendar",
    "temporal-api",
    "timezone",
    "dst",
    "overlap-layout",
    "multi-day",
    "dnd",
    "typescript",
    "month",
    "week",
    "day"
  ]
}
