{
  "name": "@gobrand/react-calendar",
  "version": "1.1.0",
  "description": "Headless Temporal calendar for React — month, week & day hooks, WAI-ARIA keyboard grid, overlap layout, DnD math, and zero-polyfill /native.",
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-brand/calendar.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/go-brand/calendar/issues"
  },
  "homepage": "https://calendar.gobrand.app",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@gobrand/calendar-core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^27.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "react",
    "react-calendar",
    "headless-calendar",
    "temporal",
    "temporal-api",
    "calendar",
    "wai-aria",
    "accessibility",
    "timezone",
    "dst",
    "hooks",
    "typescript"
  ]
}
