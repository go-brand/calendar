{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-docs",
  "main": "./src/server.ts",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/docs", "/docs/*", "/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "calendar.gobrand.app",
      "custom_domain": true
    }
  ]
}
